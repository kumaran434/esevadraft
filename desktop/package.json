{
  "name": "esevadraft-desktop",
  "version": "1.1.19",
  "description": "eSevaDraft Tamil Nadu Government e-Seva AI Desktop Automation Suite",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:protect": "node build-protected.js",
    "pack": "electron-builder --dir",
    "dist": "npm run build:protect && electron-builder --win --x64"
  },
  "author": "eSevaDraft AI Governance Team",
  "license": "Commercial-Proprietary",
  "dependencies": {
    "bytenode": "^1.5.5",
    "electron-updater": "^6.8.9",
    "playwright-core": "^1.50.0"
  },
  "devDependencies": {
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "javascript-obfuscator": "^4.1.1"
  },
  "build": {
    "appId": "in.esevadraft.desktop",
    "productName": "eSevaDraft Desktop",
    "extraResources": [
      {
        "from": "../.env",
        "to": ".env"
      },
      {
        "from": "../tnpds_automation.js",
        "to": "tnpds_automation.js"
      },
      {
        "from": "../photo_studio.js",
        "to": "photo_studio.js"
      },
      {
        "from": "../tn_district_mapper.js",
        "to": "tn_district_mapper.js"
      },
      {
        "from": "../govt_automation_core.js",
        "to": "govt_automation_core.js"
      },
      {
        "from": "../tnega_can_automation.js",
        "to": "tnega_can_automation.js"
      },
      {
        "from": "../ai_document_extractor.js",
        "to": "ai_document_extractor.js"
      },
      {
        "from": "../firestore_db.js",
        "to": "firestore_db.js"
      },
      {
        "from": "../database.js",
        "to": "database.js"
      },
      {
        "from": "../server.js",
        "to": "server.js"
      },
      {
        "from": "../package.json",
        "to": "package.json"
      },
      {
        "from": "../data",
        "to": "data",
        "filter": [
          "**/tn_bifurcated_taluks.*",
          "**/tn_pincode_taluk_map.*",
          "**/tn_village_lexicon*",
          "**/services_registry_data.json",
          "!**/drafts/**",
          "!**/citizens/**",
          "!**/applications/**",
          "!**/checkpoints/**",
          "!**/downloads/**",
          "!**/golden_samples/**",
          "!**/telemetry/**",
          "!**/tnpds_chrome_profile/**",
          "!**/users/**",
          "!**/uploads/**",
          "!**/citizens.json*",
          "!**/sessions.json*",
          "!**/operator_vault.json*",
          "!**/tnega_cookies.json*",
          "!**/latest_automation_run.json*",
          "!**/automation_incident_log.json*",
          "!**/automation_immune_memory.json*",
          "!**/aadhaar_citizen_index.json*"
        ]
      },
      {
        "from": "../src",
        "to": "src"
      },
      {
        "from": "../public",
        "to": "public"
      },
      {
        "from": "../node_modules",
        "to": "node_modules",
        "filter": [
          "!**/.bin/**",
          "!**/*.md",
          "!**/*.markdown",
          "!**/*.ts",
          "!**/*.map",
          "!**/test/**",
          "!**/tests/**",
          "!**/docs/**",
          "!**/example/**",
          "!**/examples/**"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kumaran434",
        "repo": "esevadraft"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/playwright-core/**"
    ]
  }
}
